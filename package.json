{
  "name": "tangwz-blog",
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && pagefind --site dist && cp -r dist/pagefind public/ && npm run check:build && npm run check:site",
    "test": "node --experimental-strip-types --test src/i18n/*.test.mjs src/scripts/*.test.mjs src/utils/*.test.mjs scripts/*.test.mjs",
    "check:build": "node --experimental-strip-types scripts/check-build.mjs",
    "check:site": "node --experimental-strip-types scripts/check-site.mjs",
    "release:check": "node --experimental-strip-types scripts/check-release.mjs",
    "build:release": "node --experimental-strip-types scripts/check-release.mjs --config-only && npm run build && npm run release:check",
    "preview": "astro preview",
    "sync": "astro sync",
    "astro": "astro",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint .",
    "theme:update": "node scripts/update-theme.mjs",
    "theme:upgrade": "npm run theme:update && pnpm install --frozen-lockfile && npm test && npm run build",
    "theme:check": "node scripts/update-theme.mjs --check"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.0",
    "@astrojs/mdx": "^7.0.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.0.3",
    "dayjs": "^1.11.21",
    "lodash.kebabcase": "^4.1.1",
    "mathjax-full": "^3.2.1",
    "rehype-callouts": "^2.2.0",
    "rehype-mathjax": "^7.1.0",
    "remark-collapse": "^0.1.2",
    "remark-math": "^6.0.0",
    "remark-toc": "^9.0.0",
    "satori": "^0.26.0",
    "sharp": "^0.35.2",
    "slugify": "^1.6.9",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@pagefind/default-ui": "^1.5.2",
    "@shikijs/transformers": "^4.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/lodash.kebabcase": "^4.1.9",
    "@typescript-eslint/parser": "^8.62.0",
    "eslint": "^10.6.0",
    "eslint-plugin-astro": "^2.1.1",
    "hast-util-from-html": "^2.0.3",
    "pagefind": "^1.5.2",
    "prettier": "3.9.3",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.3.0"
}
