---
import { useCreatorTranslations } from "@/i18n/creator";
const tr = useCreatorTranslations(Astro.currentLocale);
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";
import Socials from "./Socials.astro";
import type { HTMLAttributes } from "astro/types";
type Props = { noMarginTop?: boolean } & HTMLAttributes<"footer">;
const { noMarginTop: _noMarginTop, class: className, ...attrs } = Astro.props;
const href = (path: string) =>
  getRelativeLocaleUrl(Astro.currentLocale ?? config.site.lang, path);
---

<footer
  {...attrs}
  class:list={["portfolio-footer", "wide-container", className]}
  data-pagefind-ignore
>
  <div class="portfolio-footer-top">
    <a class="wordmark" href={href("")}
      >{config.site.author}<svg
        viewBox="0 0 160 18"
        fill="none"
        aria-hidden="true"
        ><path d="M3 12C43 28 69-11 115 5c17 6 29 8 42 3"></path></svg
      ></a
    >
    <nav aria-label={tr("Footer navigation")}>
      <a href={href("works/")}>{tr("My Work")}</a>
      <a href={`${href("")}#about`}>{tr("About Me")}</a>
      <a href={href("newsletter/")}>{tr("Newsletter")}</a>
      {
        config.features.search === "pagefind" && (
          <a href={href("search/")}>{tr("Search")}</a>
        )
      }
      <a href={href("rss.xml").replace(/\/+$/, "")}>RSS</a>
    </nav>
  </div>
  {
    config.socials.length > 0 && (
      <div class="portfolio-footer-socials">
        <Socials />
      </div>
    )
  }
  <div class="portfolio-footer-bottom">
    <p>
      &copy; {config.site.author}{" "}
      {new Date().getFullYear()}{tr(". Made with curiosity.")}
    </p>
    <a href={href("privacy/")}>{tr("Privacy Policy")}</a>
  </div>
</footer>
