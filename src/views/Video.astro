---
import { useCreatorTranslations } from "@/i18n/creator";
const tr = useCreatorTranslations(Astro.currentLocale);
import { render, type CollectionEntry } from "astro:content";
import PostLayout from "@/layouts/PostLayout.astro";
import EditorialPage from "@/components/EditorialPage.astro";
import BilibiliPlayer from "@/components/BilibiliPlayer.astro";
import { getAssetPath } from "@/utils/withBase";
import { getRelativeLocaleUrl } from "astro:i18n";
import { contentSlug, resolveLocale } from "@/i18n/routing";
import config from "@/config";
import { getLocaleAnchors } from "@/utils/getLocaleAnchors";
import { getContentLocales } from "@/utils/getLocalizedContent";
type Props = {
  video: CollectionEntry<"videos">;
  relatedVideos: CollectionEntry<"videos">[];
};
const { video, relatedVideos } = Astro.props;
const locale = resolveLocale(Astro.currentLocale ?? config.site.lang);
const availableLocales = await getContentLocales(video);
const relatedItems = relatedVideos.map(item => ({
  title: item.data.title,
  description: item.data.description,
  image: getAssetPath(item.data.image),
  href: getRelativeLocaleUrl(locale, `videos/${contentSlug(item.id)}`),
}));
const {
  title,
  description,
  pubDatetime,
  bilibiliUrl,
  image,
  label,
  sample,
  categories,
} = video.data;
const { Content, headings } = await render(video);
const localeAnchors = await getLocaleAnchors(video, headings, locale);
---

<PostLayout
  contentLanguage={video.data.lang}
  {availableLocales}
  title={`${title} | ${tr(config.site.title)}`}
  {description}
  ogImage={getAssetPath(image)}
  {pubDatetime}
>
  <EditorialPage
    {title}
    date={pubDatetime}
    category={categories[0]}
    kind="video"
    contentLanguage={video.data.lang}
    {headings}
    {localeAnchors}
    {relatedItems}
    searchable={availableLocales.includes(locale)}
  >
    <BilibiliPlayer
      slot="cover"
      url={bilibiliUrl}
      {title}
      image={getAssetPath(image)}
      {label}
      {sample}
    />
    <Content />
    {
      config.features.showBackButton && (
        <a
          slot="after"
          class="back-link"
          href={`${getRelativeLocaleUrl(locale, "works/")}?type=video`}
        >
          {tr("← Back to my work")}
        </a>
      )
    }
  </EditorialPage>
</PostLayout>
